{
  "name": "compare",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "pnpm --filter shared build && pnpm -r typecheck",
    "lint": "eslint ./packages/*/src",
    "lint:fix": "eslint ./packages/*/src --fix",
    "knip": "knip",
    "test": "pnpm --filter frontend test",
    "build": "pnpm --filter shared build && caido-dev build",
    "watch": "caido-dev watch"
  },
  "devDependencies": {
    "@caido-community/dev": "0.1.7",
    "@caido/eslint-config": "0.10.0",
    "@caido/tailwindcss": "0.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "9.39.2",
    "knip": "6.27.0",
    "postcss-prefixwrap": "1.51.0",
    "prettier-linter-helpers": "^1.0.0",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.3.4",
    "typescript": "5.5.4"
  }
}
