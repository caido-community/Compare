{
  "name": "frontend-vue",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "pnpm --filter shared build && pnpm -r typecheck",
    "lint": "eslint ./packages/**/src --fix",
    "build": "pnpm --filter shared build && caido-dev build",
    "watch": "caido-dev watch",
    "test": "pnpm --filter frontend test",
    "knip": "knip"
  },
  "devDependencies": {
    "prettier-linter-helpers": "^1.0.0",
    "@caido-community/dev": "^0.1.3",
    "@caido/eslint-config": "^0.5.0",
    "@caido/tailwindcss": "0.0.1",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "^9.39.2",
    "knip": "^5.83.0",
    "postcss-prefixwrap": "1.51.0",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.3.4",
    "typescript": "5.5.4"
  }
}
