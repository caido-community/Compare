{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["prettier-linter-helpers"],
  "workspaces": {
    ".": {
      "entry": ["caido.config.ts"]
    },
    "packages/backend": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["caido"]
    },
    "packages/frontend": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,vue}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
